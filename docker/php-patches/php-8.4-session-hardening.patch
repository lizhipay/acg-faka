  * code may run. Objects are then kept as __PHP_Incomplete_Class: no
  * autoloading, no unserialize_callback_func, no __wakeup() or __unserialize(),
  * and they are written back unchanged. */
+/* Shared empty allowed-classes set: makes session unserialize refuse every
+ * class (objects become __PHP_Incomplete_Class), neutralising serialize_handler
+ * mismatch object injection. Allocated once in MINIT. */
+static HashTable *php_session_no_classes = NULL;
+
 static void php_session_unserialize_init(php_unserialize_data_t *var_hash)
 {
 	PHP_VAR_UNSERIALIZE_INIT(*var_hash);
 	if (PS(in_rfc1867_update)) {
 		php_var_unserialize_set_incomplete_classes_only(*var_hash, true);
 	}
+	if (PS(harden) && php_session_no_classes) {
+		php_var_unserialize_set_allowed_classes(*var_hash, php_session_no_classes);
+	}
 }
 
